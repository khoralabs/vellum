{
  "name": "@khoralabs/vellum-client",
  "version": "0.3.0",
  "description": "Vellum API client: daemon control POST + Bun SQLite channel store.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/vellum.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/khoralabs/vellum/tree/main/packages/client",
  "bugs": "https://github.com/khoralabs/vellum/issues",
  "keywords": [
    "vellum",
    "client",
    "obp",
    "khoralabs"
  ],
  "files": [
    "dist",
    "vellum-config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "bun": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "bun": "./src/transport/index.ts",
      "import": "./src/transport/index.ts",
      "default": "./src/transport/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "bun": "./src/session/index.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./persistence": {
      "types": "./src/persistence/core/index.ts",
      "bun": "./src/persistence/core/index.ts",
      "import": "./src/persistence/core/index.ts",
      "default": "./src/persistence/core/index.ts"
    },
    "./sqlite": {
      "types": "./src/persistence/sqlite/index.ts",
      "bun": "./src/persistence/sqlite/index.ts",
      "import": "./src/persistence/sqlite/index.ts",
      "default": "./src/persistence/sqlite/index.ts"
    },
    "./pool": {
      "types": "./src/pool/index.ts",
      "bun": "./src/pool/index.ts",
      "import": "./src/pool/index.ts",
      "default": "./src/pool/index.ts"
    },
    "./vellum-config.schema.json": "./vellum-config.schema.json"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:schema": "bun run scripts/build-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@khoralabs/relay": "^0.1.1",
    "@khoralabs/did-key-identity": "^0.1.0",
    "@khoralabs/obp-core": "^0.2.0",
    "@khoralabs/obp-nbc": "^0.2.0",
    "@khoralabs/obp-wire": "^0.2.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
