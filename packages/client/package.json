{
  "name": "@khoralabs/vellum-client",
  "version": "0.1.0",
  "description": "Vellum API client: daemon control POST + SQLite reads.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/vellum.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/khoralabs/vellum/tree/main/packages/client",
  "bugs": "https://github.com/khoralabs/vellum/issues",
  "keywords": [
    "vellum",
    "client",
    "obp",
    "khoralabs"
  ],
  "files": [
    "dist",
    "vellum-config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vellum-config.schema.json": "./vellum-config.schema.json"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:schema": "bun run scripts/build-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@khoralabs/relay": "^0.1.1",
    "@khoralabs/did-key-identity": "^0.1.0",
    "@khoralabs/obp-core": "^0.1.0",
    "@khoralabs/obp-nbc": "^0.1.0",
    "@khoralabs/vellum-contracts": "workspace:*",
    "@khoralabs/vellum-transport": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
