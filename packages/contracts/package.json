{
  "name": "@khoralabs/vellum-contracts",
  "version": "0.0.0",
  "description": "Zod schemas and shared types for Vellum control/NBC wire formats.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/vellum.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/khoralabs/vellum/tree/main/packages/contracts",
  "bugs": "https://github.com/khoralabs/vellum/issues",
  "keywords": [
    "vellum",
    "contracts",
    "zod",
    "khoralabs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && bun build ./src/index.ts --outfile=dist/index.js --target=node --format=esm --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
