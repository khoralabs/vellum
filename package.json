{
  "name": "@khoralabs/vellum",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "vendor/libs/packages/*/**"
    ],
    "catalog": {
      "@khoralabs/did-key-identity": "^0.1.0",
      "@khoralabs/obp-core": "^0.2.1",
      "@khoralabs/obp-nbc": "^0.2.1",
      "@khoralabs/obp-wire": "^0.2.1",
      "@khoralabs/relay": "^0.3.0",
      "@types/bun": "latest",
      "typescript": "^5",
      "zod": "^4"
    }
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "rm -rf packages/client/dist && bun run --filter '@khoralabs/vellum-*' typecheck",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "git submodule update --remote --merge vendor/libs && bun install",
    "submodules:update:libs": "git submodule update --remote --merge vendor/libs && bun install",
    "prepare": "husky",
    "review": "agent-review run --scope staged --include-workstream"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@khoralabs/agent-review": "0.2.2",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "typescript": "catalog:"
  }
}
