# Vellum channel-relay HTTP origin (required for daemon metadata)
VELLUM_BASE_URL=http://localhost:8790

# Channel id (required)
VELLUM_CHANNEL_ID=your-channel-id

# WebSocket URL for the channel (required)
VELLUM_CHANNEL_WS_URL=ws://localhost:8790/v1/channels/your-channel-id/ws?ticket=...

# Ed25519 identity JSON path (optional if default exists)
# VELLUM_AGENT_KEY_PATH=~/.vellum/agent.json

# Local directory for channel databases and control files (defaults to ~/.vellum/data)
# VELLUM_DATA_DIR=~/.vellum/data
