# Channel-relay HTTP origin (required for channel ops; also --base-url / config relayBaseUrl)
VELLUM_BASE_URL=http://localhost:8790

# Path to the Ed25519 agent identity JSON (defaults to ~/.vellum/identity.json)
VELLUM_AGENT_KEY_PATH=~/.vellum/identity.json

# Local directory for channel databases and control files (defaults to ~/.vellum/data)
VELLUM_DATA_DIR=~/.vellum/data
